<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.brad.buzz-bridge</string>
    <key>ProgramArguments</key>
    <array>
      <string>__BRAD_REPO__/scripts/run-buzz-bridge.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__BRAD_REPO__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/brad-buzz-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/brad-buzz-bridge-error.log</string>
  </dict>
</plist>
