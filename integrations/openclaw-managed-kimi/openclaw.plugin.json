{
  "id": "brad-managed-kimi",
  "name": "Brad Managed Kimi Bridge",
  "description": "Correlates managed Kimi runs with exact Brad durable-control-plane claims.",
  "version": "1.5.0",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["managedAgentId", "managedMainAccountDigest", "managedOwnerIdentity", "modelProvider", "model", "recoveryEnabled"],
    "properties": {
      "managedAgentId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "managedMainAccountDigest": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "description": "SHA-256 fingerprint of the managed Kimi main-session account identifier."
      },
      "managedOwnerIdentity": {
        "type": "string",
        "minLength": 1,
        "maxLength": 384,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*:[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "description": "Exact authenticated managed-channel identity, such as kimi-claw:main."
      },
      "modelProvider": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      },
      "recoveryEnabled": {
        "type": "boolean",
        "description": "Run the two-minute durable recovery scheduler. Disable in staging."
      }
    }
  }
}
