NODE_ENV=development

# Core
DATABASE_URL=postgres://postgres:postgres@postgres:5432/brad
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-long-random-secret
APP_BASE_URL=https://api.brad.com
WEB_BASE_URL=https://brad.com
API_BASE_URL=https://api.brad.com
BETA_ALLOW_UNVERIFIED_WEB=false
BETA_STRICT_APPROVALS=true
BETA_KILL_SWITCH_WRITES=false

# OpenClaw
OPENCLAW_MODE=http
OPENCLAW_URL=http://127.0.0.1:8080
OPENCLAW_API_KEY=
OPENCLAW_CLI_BIN=openclaw
OPENCLAW_CLI_AGENT_ID=brad-runtime
OPENCLAW_CLI_TIMEOUT_MS=90000
OPENCLAW_MODEL_DEFAULT=gpt-4.1
OPENCLAW_MODEL_TEMPERATURE=0.2
DEFAULT_TIMEZONE=America/Chicago

# Call-E outbound phone agent
# Leave CALLE_CLI_BIN blank to use local `npx --no-install calle`.
# Run `npx calle auth status --no-telemetry` to confirm the local token is usable.
CALLE_CLI_BIN=
CALLE_TIMEOUT_SECONDS=30
CALLE_TELEMETRY=false

# Brad conductor. Keep shadow until all promotion gates pass.
BRAD_CONDUCTOR_MODE=shadow
BRAD_AGENT_MAX_TURNS=8
BRAD_AGENT_MAX_COST_MICROS=5000000
BRAD_AGENT_WORKER_IDENTITY=brad-worker
BRAD_AGENT_LEASE_SECONDS=300
BRAD_AGENT_WORKFLOW_VERSION=brad-conductor-v1
BRAD_AGENT_STREAM_KEY=brad:agent:jobs
BRAD_AGENT_STREAM_GROUP=brad-agent-workers
BRAD_AGENT_BRIDGE_TOKEN=

# Hermes bounded worker
HERMES_RUNNER_PATH=/home/benjijmac/bin/hermes-task-runner.sh
HERMES_OUTPUT_ROOT=/home/benjijmac/.hermes/brad-agent-runs
HERMES_RUNNER_TIMEOUT_MS=900000
HERMES_PROVIDER=openai-codex
HERMES_MODEL=gpt-5.4-mini

# Mac-side Buzz bridge. Keep the private key in the existing protected key file.
BRAD_API_BASE_URL=http://127.0.0.1:3000
BUZZ_CLI_BIN=buzz
BUZZ_RELAY_URL=ws://127.0.0.1:3100
BUZZ_PRIVATE_KEY_FILE=~/.config/buzz/keys/owner.key
BUZZ_CHANNEL_ID=
BUZZ_CODEX_PUBKEY=
BUZZ_CLAUDE_PUBKEY=
BUZZ_BRIDGE_PUBKEY=
BUZZ_CODEX_MENTION=@Codex
BUZZ_CLAUDE_MENTION=@Claude
BRAD_BUZZ_POLL_MS=3000

# Twilio SMS + WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Compatibility alias: TWILIO_FROM_NUMBER can be used instead of TWILIO_SMS_FROM.
TWILIO_SMS_FROM=+15550001111
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Voice-capable number for deterministic IVR/keypad calls. Falls back to TWILIO_SMS_FROM when blank.
TWILIO_VOICE_FROM=

# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_GRAPH_API_VERSION=v22.0
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=https://api.brad.com/auth/login/google/callback
GOOGLE_OAUTH_REDIRECT_URI=https://api.brad.com/auth/link/google/callback

# GCP KMS (optional in local dev)
KMS_KEY_NAME=projects/PROJECT_ID/locations/global/keyRings/brad/cryptoKeys/connector-tokens

# Browser safety
BROWSER_ALLOWLIST=example.com,forms.gle,docs.google.com

# Linear command board + Hermes bounded worker
# Keep LINEAR_API_KEY in a mode-0600 service environment file, never in Git.
BRAD_OWNER_PERSON_ID=
LINEAR_API_KEY=
LINEAR_PROJECT_ID=18f0f6f2-60ae-49fb-a632-1e82e761f5cf
LINEAR_DISPATCH_LABEL=Brad Run
LINEAR_HERMES_LABEL=Hermes
LINEAR_CANARY_LABEL=Brad Canary
LINEAR_SKILL_LABEL_PREFIX=Skill:
# Leave empty until a skill wins the checked-in A/B benchmark without weakening safety or evidence quality.
HERMES_ALLOWED_SKILLS=
HERMES_RUNNER_PATH=/home/benjijmac/bin/hermes-task-runner.sh
HERMES_OUTPUT_ROOT=/home/benjijmac/server-audits/brad-hermes-jobs
HERMES_TASK_TIMEOUT_MS=240000
HERMES_PROVIDER=openai-codex
HERMES_MODEL=gpt-5.4-mini
